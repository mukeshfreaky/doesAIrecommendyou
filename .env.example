# ==============================================================================
# DOES AI RECOMMEND YOU - ENVIRONMENT CONFIGURATION (.env.example)
#
# IMPORTANT SECURITY RULES:
# 1. NEVER commit API keys to version control.
# 2. Provider API keys MUST ALWAYS remain server-side.
# 3. Copy this file to .env.local for local development.
# ==============================================================================

# Server-side AI Provider API Keys (At least one is required for live scans)
# Google Gemini with Real Google Search Grounding (Primary provider)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Hard Live-API Safety Gate (Prevents accidental API-cost explosions)
AI_LIVE_ENABLED=false
AI_MAX_LIVE_CALLS=10

# Perplexity Sonar (Extension provider)
PERPLEXITY_API_KEY=

# OpenAI / Experiential Gateway Configuration
# Authenticates with your Experiential API key from EXPLABS_API_KEY
EXPLABS_API_KEY=
EXPLABS_BASE_URL=https://api.experientiallabs.ai/v1
OPENAI_MODEL=gpt-5.6-luna
OPENAI_API_KEY=

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Optional Analytics & Telemetry
NEXT_PUBLIC_GA_MEASUREMENT_ID=
